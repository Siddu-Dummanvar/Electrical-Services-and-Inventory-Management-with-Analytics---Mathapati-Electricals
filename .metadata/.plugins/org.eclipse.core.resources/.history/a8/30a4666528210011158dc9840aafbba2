<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Home | E S & Inventory Analytics</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" th:href="@{/styles.css}">
	<link rel="stylesheet" th:href="@{/css/products.css}">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">


	<style>
		/*Navbar height smaller */
		.navbar {
			padding-top: 0px;
			padding-bottom: 0px;
			background: linear-gradient(90deg, #022860, #3f97db);
			margin-bottom: 1px;
		}

		/*Remove underline and add smooth hover transition */
		.navbar-nav .nav-item a {
			text-decoration: none !important;
			color: #fdf8f8 !important;
			transition: all 0.3s ease;
			display: inline-block;
		}

		/*Hover effect — color change + slight upward movement */
		.navbar-nav .nav-item a:hover {
			color: #111011 !important;
			transform: translateY(-3px);
		}

		/*Adjust brand text & logo alignment */
		.navbar-brand span {
			display: block;
			font-size: 0.9rem;
			color: #170101;
		}

		.navbar-brand img {
			border: 2px solid white;
		}

		/* Dropdown item color and hover effect */
		.dropdown-menu .dropdown-item {
			color: black !important;
			transition: all 0.3s ease;
			color: #170101;
		}

		.dropdown-menu .dropdown-item:hover {
			background-color: #28a745 !important;
			color: rgb(19, 1, 1) !important;
		}

		/* THIS IS THE STYLE I MISSED. IT IS NOW ADDED BACK.
		*/
		.carousel-item img {
			height: 400px;
			object-fit: cover;
		}


		/* ... existing navbar and carousel styles ... */

		/* Your product card styles for Home.html (Category Cards) */
		.product-card {
			border: 1px solid #ced4da;
			/* Light ash border */
			border-radius: 10px;
			padding: 15px;
			background: #e9ecef;
			/* Light gray background for cards */
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
			/* Softer, professional shadow */
			transition: transform 0.2s ease, box-shadow 0.2s ease;
		}

		.product-card:hover {
			transform: translateY(-5px);
			box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
			/* Slightly more pronounced shadow on hover */
		}

		.product-img img {
			width: 100%;
			height: 200px;
			object-fit: cover;
			border-radius: 8px;
		}





		.product-img img {
			width: 100%;
			height: 200px;
			/* Added uniform height */
			object-fit: cover;
			border-radius: 8px;
		}


		/* ===========================
		   FEEDBACK STAR RATING CSS
		   =========================== */

		/* 1. Container: Aligns stars and reverses them for the CSS hover trick */
		.rating {
			display: flex;
			flex-direction: row-reverse;
			justify-content: center;
			gap: 5px;
		}

		/* 2. Hide the actual radio buttons */
		.rating input {
			display: none;
		}

		/* 3. Style the Star Icons */
		.rating label {
			font-size: 2.5rem;
			/* Big stars */
			color: #d1d1d1;
			/* Default gray color */
			cursor: pointer;
			transition: color 0.2s;
		}

		/* 4. Gold Color Logic 
		   - Turns gold when checked
		   - Turns gold when hovering
		*/
		.rating input:checked~label,
		.rating label:hover,
		.rating label:hover~label {
			color: #ffc107;
			/* Golden Yellow */
		}
	</style>
</head>

<body>
	<nav class="navbar navbar-expand-lg navbar-dark">
		<div class="container">
			<a class="navbar-brand text-center" href="#">
				<img th:src="@{/images/tiger.jpg}" class="me-2 rounded-circle" alt="Logo" width="50" height="50">
				Mathapati Electricals
			</a>

			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
				aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav ms-auto">
					<li class="nav-item mx-2 fs-5"><a class="nav-link text-dark" th:href="@{/Home}">Home</a></li>
					<li class="nav-item mx-2 fs-5"><a class="nav-link text-dark" href="#aboutus">About</a></li>
					<li class="nav-item mx-2 fs-5"><a class="nav-link text-dark" th:href="@{/services}">Services</a>
					</li>

					<a th:href="@{/user-profile}" title="Go to My Profile">
						<svg xmlns="http://www.w3.org/2000/svg" width="65" height="56" fill="white"
							class="bi bi-person-circle" viewBox="0 0 16 16"
							style="padding-left: 28px; cursor: pointer;">
							<path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" />
							<path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37
          C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" />
						</svg>
					</a>
				</ul>
			</div>
		</div>
	</nav>

	<div id="carouselExampleCaptions" class="carousel slide">
		<div class="carousel-indicators">
			<button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="0" class="active"
				aria-current="true" aria-label="Slide 1"></button>
			<button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="1"
				aria-label="Slide 2"></button>
			<button type="button" data-bs-target="#carouselExampleCaptions" data-bs-slide-to="2"
				aria-label="Slide 3"></button>
		</div>
		<div id="services" class="carousel-inner">
			<div class="carousel-item active">
				<img th:src="@{/images/sound-service.png}" class="d-block w-100 " alt="...">
				<div class="carousel-caption d-none d-md-block">
					<h5>Sound Services</h5>
					<p>Experience Audio Excellence</p>
				</div>
			</div>
			<div class="carousel-item">
				<img th:src="@{/images/home-light-decoration.png}" class="d-block w-100" alt="...">
				<div class="carousel-caption d-none d-md-block">
					<h5>Home Lighting</h5>
					<p>Illuminate your self.</p>
				</div>
			</div>
			<div class="carousel-item">
				<img th:src="@{/images/Electrical.png}" class="d-block w-100" alt="...">
				<div class="carousel-caption d-none d-md-block">
					<h5>Electrical Services</h5>
					<p>Installation Maintanance Upgrade</p>
				</div>
			</div>

		</div>
		<button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleCaptions"
			data-bs-slide="prev">
			<span class="carousel-control-prev-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Previous</span>
		</button>
		<button class="carousel-control-next" type="button" data-bs-target="#carouselExampleCaptions"
			data-bs-slide="next">
			<span class="carousel-control-next-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Next</span>
		</button>
	</div>


	<div class="container my-5">
		<h1 class="text-center mb-2">Product Categories</h1>
		<p class="text-center text-muted mb-4">
			Browse our selection of quality electrical products
		</p>

		<div class="row justify-content-center mb-5">
			<div class="col-md-6">
				<form th:action="@{/Home}" method="get" class="d-flex gap-2">

					<input class="form-control form-control-lg border-secondary" type="search" name="keyword"
						th:value="${keyword}" placeholder="Search for Fan, Bulb, Wire..." aria-label="Search">

					<button class="btn btn-primary" type="submit">
						<i class="bi bi-search"></i>
					</button>

					<a th:if="${keyword != null && keyword != ''}" th:href="@{/index}" class="btn btn-outline-secondary"
						title="Clear Search">
						<i class="bi bi-x-lg"></i>
					</a>
				</form>
			</div>
		</div>

		<div class="row g-4" id="product-list">

			<div class="col-12 col-md-6 col-lg-4 col-xl-3" th:each="category : ${categories}">
				<div class="product-card">
					<a th:href="@{/products/category/{id}(id=${category.id})}"
						style="text-decoration: none; color: inherit;">
						<div class="product-img">
							<img th:if="${category.imageName != null}" th:src="@{'/images/' + ${category.imageName}}"
								th:alt="${category.name}" />

							<div th:unless="${category.imageName != null}" th:switch="${category.name}">
								<img th:case="'Fan'" th:src="@{/images/fan.jpg}" alt="Fan" />
								<img th:case="'LED Bulb'" th:src="@{/images/led-bulb.avif}" alt="LED Bulb" />
								<img th:case="'Switchboard'" th:src="@{/images/switcgboard.jpeg}" alt="Switchboard" />
								<img th:case="'Screwdriver'" th:src="@{/images/screw-driver.png}" alt="Screwdriver" />
								<img th:case="'Tester'" th:src="@{/images/tester.jpg}" alt="Tester" />
								<img th:case="'Inverter'" th:src="@{/images/inverter.jpeg}" alt="Inverter" />
								<img th:case="'MCB'" th:src="@{/images/mcb.jpeg}" alt="MCB" />
								<img th:case="'Extension Board'" th:src="@{/images/extensioncord.jpeg}"
									alt="Extension Board" />
								<img th:case="'Electrical Wire'" th:src="@{/images/wire.jpeg}" alt="Electrical Wire" />
								<img th:case="*" th:src="@{/images/mcb.jpeg}" alt="Default" />
							</div>
						</div>

						<h5 class="product-title" th:text="${category.name}">Category Name</h5>
					</a>
				</div>
			</div>
		</div>

		<!--Feedback form-->

		<div class="container my-5">
			<div class="card shadow-sm border-0 bg-light">
				<div class="card-body p-5 text-center">

					<h3 class="mb-3">We Value Your Feedback</h3>
					<p class="text-muted">Tell us about your experience with Mathapati Electricals.</p>

					<div th:if="${feedbackMsg}" class="alert alert-success col-md-6 mx-auto">
						<i class="bi bi-heart-fill me-2"></i> <span th:text="${feedbackMsg}"></span>
					</div>

					<form th:action="@{/submitFeedback}" method="post" th:object="${newFeedback}"
						class="col-md-6 mx-auto">

						<div class="mb-3">
							<div class="rating">
								<input type="radio" id="star5" name="rating" value="5" th:field="*{rating}" />
								<label for="star5" title="Excellent"><i class="bi bi-star-fill"></i></label>

								<input type="radio" id="star4" name="rating" value="4" th:field="*{rating}" />
								<label for="star4" title="Good"><i class="bi bi-star-fill"></i></label>

								<input type="radio" id="star3" name="rating" value="3" th:field="*{rating}" />
								<label for="star3" title="Average"><i class="bi bi-star-fill"></i></label>

								<input type="radio" id="star2" name="rating" value="2" th:field="*{rating}" />
								<label for="star2" title="Poor"><i class="bi bi-star-fill"></i></label>

								<input type="radio" id="star1" name="rating" value="1" th:field="*{rating}" />
								<label for="star1" title="Very Bad"><i class="bi bi-star-fill"></i></label>
							</div>
						</div>

						<div class="mb-3">
							<textarea class="form-control" rows="3" th:field="*{message}"
								placeholder="Write your review here..." required></textarea>
						</div>

						<button type="submit" class="btn btn-primary px-4">Submit Review</button>
					</form>

				</div>
			</div>
		</div>
		<script>
			function goBack() {
				window.history.back();
			}
		</script>

		<!--footer fragment starts-->
		<div th:replace="~{fragments/footer-page :: fullFooter}"></div>
		<!--Footer fragment ends--> <!-- Bootstrap JS (CDN) -->
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>