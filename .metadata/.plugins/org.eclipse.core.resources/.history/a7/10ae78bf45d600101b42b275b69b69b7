<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
	<title>Service Management | Admin</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
	<link rel="stylesheet" th:href="@{/styles.css}">
	<style>
		/* Small CSS for the timeline/status badges */
		.status-badge {
			font-size: 0.9rem;
			padding: 5px 10px;
			border-radius: 20px;
		}

		.bg-new {
			background-color: #e3f2fd;
			color: #0d47a1;
		}

		.bg-pending {
			background-color: #fff3cd;
			color: #856404;
		}

		.bg-progress {
			background-color: #d1e7dd;
			color: #0f5132;
		}

		.bg-completed {
			background-color: #198754;
			color: white;
		}

		.sidebar {
			height: 90vh;
			width: 250px;
			background-color: #071b38;
			margin-top: 10px;
		}

		.fontStyle {
			color: #f6eeee;
			text-decoration: none;
			font-style: normal;
			font-size: large;
		}

		.navlink {
			padding-top: 10px;
			padding-bottom: 15px;
			padding-left: 20px;
		}

		.navlink:hover {
			background-color: #072f4e
		}
	</style>
</head>

<body>

	<div th:replace="~{fragments/admin-navbar :: adminNavbar}"></div>

	<section>
		<div class="container-fluid d-flex p-0">
			<div th:replace="~{fragments/admin-sidebar :: adminSidebar}"></div>

			<div class="flex-grow-1 p-4" style="background-color: #f5f5f5;">
				<div class="container-fluid">
					<h2 class="mb-4">Service Request Management</h2>

					<div th:if="${msg}" class="alert alert-success" th:text="${msg}"></div>

					<div class="table-responsive bg-white p-3 rounded shadow-sm">
						<table class="table table-hover align-middle">
							<thead class="table-dark">
								<tr>
									<th>ID</th>
									<th>Customer Info</th>
									<th>Service Details</th>
									<th>Payment</th>
									<th>Current Status</th>
									<th>Assigned Head</th>
									<th>Action</th>
								</tr>
							</thead>
							<tbody>
								<tr th:each="req : ${requests}">
									<td th:text="${req.id}">1</td>
									<td>
										<strong th:text="${req.fullName}">Name</strong><br>
										<small th:text="${req.phoneNumber}">Phone</small><br>
										<small th:text="${req.location}" class="text-muted">Loc</small>
									</td>
									<td>
										<span class="badge bg-secondary mb-1"
											th:text="${req.serviceType}">Type</span><br>
										<small
											th:text="${req.preferredDate} + ' @ ' + ${req.preferredTime}">Date</small>
									</td>
									<td>
										<span class="badge bg-success">Paid</span><br>
										<small style="font-size: 10px;" th:text="${req.transactionId}">ID</small>
									</td>
									<td>
										<span th:text="${req.serviceStatus}"
											th:class="'badge status-badge ' + 
                                              (${req.serviceStatus == 'Completed'} ? 'bg-completed' : 
                                              (${req.serviceStatus == 'Under Progress'} ? 'bg-progress' : 
                                              (${req.serviceStatus == 'Work Not Started'} ? 'bg-pending' : 'bg-new')))">
										</span>
									</td>

									<td>
										<div th:if="${req.assignedEmployee == null}">
											<form th:action="@{/admin/services/assign}" method="post" class="d-flex">
												<input type="hidden" name="requestId" th:value="${req.id}">
												<select name="employeeEmail" class="form-select form-select-sm me-2"
													required>
													<option value="">Select Staff</option>
													<option th:each="emp : ${employees}"
														th:if="${emp.status == 'ACTIVE' and emp.workStatus == 'FREE'}"
														th:value="${emp.email}"
														th:text="${emp.firstName + ' (' + emp.jobTitle + ')'}">
													</option>
												</select>
												<button type="submit" class="btn btn-sm btn-primary">Assign</button>
											</form>
										</div>
										<div th:if="${req.assignedEmployee != null}">
											<i class="bi bi-person-badge-fill text-primary"></i>
											<span th:text="${req.assignedEmployee.firstName}">Name</span>
										</div>
									</td>

									<td>
										<div
											th:if="${req.assignedEmployee != null and req.serviceStatus != 'Completed'}">
											<form th:action="@{/admin/services/updateStatus}" method="post">
												<input type="hidden" name="requestId" th:value="${req.id}">
												<select name="status" class="form-select form-select-sm mb-1"
													onchange="this.form.submit()">
													<option value="" selected disabled>Update Status</option>
													<option value="Work Not Started">Work Not Started</option>
													<option value="Under Progress">Under Progress</option>
													<option value="Completed">Completed</option>
												</select>
											</form>
										</div>
										<span th:if="${req.serviceStatus == 'Completed'}" class="text-success fw-bold">
											<i class="bi bi-check-all"></i> Done
										</span>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</section>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>