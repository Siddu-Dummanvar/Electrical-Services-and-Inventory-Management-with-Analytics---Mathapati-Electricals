<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">

<head>
	<meta charset="UTF-8">
	<title>Employee Dashboard</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

	<style>
		body {
			background-color: #f4f6f9;
			overflow-x: hidden;
		}

		/* CSS to make sidebar and header work together */
		.sidebar {
			height: 100vh;
			width: 100%;
		}

		.status-card {
			border-left: 5px solid;
		}

		.card-free {
			border-color: #198754;
		}

		.card-busy {
			border-color: #dc3545;
		}

		.navlink:hover {
			background-color: #072f4e;
			border-left: 4px solid #3f97db;
		}
	</style>
</head>

<body>

	<div th:replace="~{employeeFragments/employee-header :: employeeHeader}"></div>

	<div class="container-fluid">
		<div class="row">

			<div class="col-md-2 p-0">
				<div th:replace="~{employeeFragments/employee-sidebar :: employeeSidebar}"></div>
			</div>

			<div class="col-md-10 p-4">

				<div class="d-flex justify-content-between align-items-center mb-4">
					<h3 class="fw-bold text-dark">My Dashboard</h3>
					<div class="card shadow-sm status-card"
						th:classappend="${employee.workStatus == 'FREE' ? 'card-free' : 'card-busy'}">
						<div class="card-body py-2 px-4">
							<span class="text-muted small">Status</span><br>
							<strong th:class="${employee.workStatus == 'FREE' ? 'text-success' : 'text-danger'}"
								th:text="${employee.workStatus}">FREE</strong>
						</div>
					</div>
				</div>

				<div th:if="${msg}" class="alert alert-success alert-dismissible fade show" role="alert">
					<i class="bi bi-check-circle-fill"></i> <span th:text="${msg}"></span>
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				</div>

				<div th:if="${role == 'DELIVERY'}">
					<div class="card shadow border-0">
						<div class="card-header bg-primary text-white">
							<h5 class="mb-0">Pending Deliveries</h5>
						</div>
						<div class="card-body p-0">
							<table class="table table-hover mb-0">
								<thead class="table-light">
									<tr>
										<th>Order ID</th>
										<th>Customer</th>
										<th>Amount</th>
										<th>Status</th>
										<th>Action</th>
									</tr>
								</thead>
								<tbody>
									<tr th:each="order : ${myDeliveries}">
										<td th:text="'#' + ${order.id}"></td>
										<td>
											<span th:text="${order.user.firstName}"></span><br>
											<small class="text-muted" th:text="${order.user.phoneNo}"></small>
										</td>
										<td class="text-success fw-bold" th:text="'₹' + ${order.price}"></td>
										<td><span class="badge bg-warning text-dark"
												th:text="${order.deliveryStatus}"></span></td>
										<td>
											<form th:action="@{/employee/updateDeliveryStatus}" method="post"
												th:if="${order.deliveryStatus != 'Delivered'}">
												<input type="hidden" name="orderId" th:value="${order.id}">
												<div class="input-group input-group-sm">
													<select name="status" class="form-select">
														<option value="Out for Delivery">Out for Delivery</option>
														<option value="Delivered">Delivered</option>
													</select>
													<button class="btn btn-dark" type="submit">Update</button>
												</div>
											</form>
											<span th:if="${order.deliveryStatus == 'Delivered'}"
												class="text-success fw-bold">Done</span>
										</td>
									</tr>
									<tr th:if="${myDeliveries.empty}">
										<td colspan="5" class="text-center p-4">No deliveries found.</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<div th:if="${role == 'TECHNICIAN'}">
					<div class="card shadow border-0">
						<div class="card-header bg-primary text-white">
							<h5 class="mb-0">Assigned Services</h5>
						</div>
						<div class="card-body p-0">
							<table class="table table-hover mb-0">
								<thead class="table-light">
									<tr>
										<th>Service ID</th>
										<th>Customer</th>
										<th>Service Type</th>
										<th>Status</th>
										<th>Action</th>
									</tr>
								</thead>
								<tbody>
									<tr th:each="task : ${myTasks}">
										<td th:text="'REQ-' + ${task.id}"></td>
										<td>
											<span th:text="${task.fullName}"></span><br>
											<small class="text-muted" th:text="${task.phoneNumber}"></small>
										</td>
										<td th:text="${task.serviceType}"></td>
										<td><span class="badge bg-info" th:text="${task.serviceStatus}"></span></td>
										<td>
											<form th:action="@{/employee/updateServiceStatus}" method="post"
												th:if="${task.serviceStatus != 'Completed'}">
												<input type="hidden" name="requestId" th:value="${task.id}">
												<div class="input-group input-group-sm">
													<select name="status" class="form-select">
														<option value="Under Progress">In Progress</option>
														<option value="Completed">Completed</option>
													</select>
													<button class="btn btn-primary" type="submit">Update</button>
												</div>
											</form>
											<span th:if="${task.serviceStatus == 'Completed'}"
												class="text-success fw-bold">Completed</span>
										</td>
									</tr>
									<tr th:if="${myTasks.empty}">
										<td colspan="5" class="text-center p-4">No services assigned.</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>

				<div th:if="${role == 'DELIVERY'}">
					<div class="card shadow border-0">
						<div class="card-header bg-primary text-white py-3">
							<h5 class="mb-0"><i class="bi bi-truck"></i> Pending Deliveries</h5>
						</div>
						<div class="card-body p-0">
							<div class="table-responsive">
								<table class="table table-hover align-middle mb-0">
									<thead class="table-light">
										<tr>
											<th>Order ID</th>
											<th>Customer Info</th>
											<th>Amount to Collect</th>
											<th>Current Status</th>
											<th>Action</th>
										</tr>
									</thead>
									<tbody>
										<tr th:each="order : ${myDeliveries}">
											<td class="fw-bold" th:text="'ORD-' + ${order.id}"></td>
											<td>
												<span
													th:text="${order.user.firstName + ' ' + order.user.lastName}">Name</span><br>
												<small class="text-muted"
													th:text="${order.user.phoneNo}">Phone</small><br>
												<small class="text-muted" th:text="${order.user.city}">City</small>
											</td>
											<td>
												<h5 class="text-success mb-0" th:text="'₹' + ${order.price}"></h5>
												<span class="badge bg-secondary"
													th:text="${order.paymentType}">COD</span>
											</td>
											<td>
												<span class="badge"
													th:classappend="${order.deliveryStatus == 'Delivered' ? 'bg-success' : 'bg-warning text-dark'}"
													th:text="${order.deliveryStatus}">Pending</span>
											</td>
											<td>
												<form th:if="${order.deliveryStatus != 'Delivered'}"
													th:action="@{/employee/updateDeliveryStatus}" method="post">
													<input type="hidden" name="orderId" th:value="${order.id}">
													<div class="input-group input-group-sm">
														<select name="status" class="form-select">
															<option value="Out for Delivery">Out for Delivery</option>
															<option value="Delivered">Delivered (Cash Collected)
															</option>
														</select>
														<button class="btn btn-dark" type="submit">Update</button>
													</div>
												</form>
												<span th:if="${order.deliveryStatus == 'Delivered'}"
													class="text-success fw-bold">
													<i class="bi bi-check-circle-fill"></i> Completed
												</span>
											</td>
										</tr>
										<tr th:if="${myDeliveries.empty}">
											<td colspan="5" class="text-center py-5 text-muted">No pending deliveries.
											</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>

			</div>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>