    /*Navbar height smaller */
    .navbar {
      padding-top: 0px;
      padding-bottom: 0px;
      background: linear-gradient(90deg, #022860, #3f97db);
      margin-bottom: 1px;
    }

    /*Remove underline and add smooth hover transition */
    .navbar-nav .nav-item a {
      text-decoration: none !important;
      color: #fdf8f8 !important;
      transition: all 0.3s ease;
      display: inline-block;
    }

    /*Hover effect — color change + slight upward movement */
    .navbar-nav .nav-item a:hover {
      color: #111011 !important;
      transform: translateY(-3px);
    }

    /*Adjust brand text & logo alignment */
    .navbar-brand span {
      display: block;
      font-size: 0.9rem;
      color: #170101;
    }

    .navbar-brand img {
      border: 2px solid white;
    }

    /* Dropdown item color and hover effect */
