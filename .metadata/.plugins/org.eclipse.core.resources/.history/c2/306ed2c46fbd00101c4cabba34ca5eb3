<!DOCTYPE html>
<html lang="en" xmlns="http://www.thymeleaf.org">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Home | E S & Inventory Analytics</title>
	<!-- Bootstrap CSS (CDN) -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

	<!-- Custom CSS -->
	<link rel="stylesheet" href="styles.css">
	<link rel="stylesheet" href="./products.css">

	<style>
		/*Navbar height smaller */
		.navbar {
			padding-top: 0px;
			padding-bottom: 0px;
			background: linear-gradient(90deg, #022860, #3f97db);
			margin-bottom: 1px;
		}

		/*Remove underline and add smooth hover transition */
		.navbar-nav .nav-item a {
		    text-decoration: none !important;
		    color: #fdf8f8 !important; /* Keeps text white */
		    transition: all 0.3s ease;
		    /* Add padding and border-radius for the new effect */
		    padding: 8px 12px; 
		    border-radius: 5px;
		}

		/* New professional hover effect */
		.navbar-nav .nav-item a:hover {
		    /* We removed the 'transform' and 'color' change */
		    /* Instead, we add a subtle background highlight */
		    background-color: rgba(255, 255, 255, 0.15); 
		}		

		/*Adjust brand text & logo alignment */
		.navbar-brand span {
			display: block;
			font-size: 0.9rem;
			color: #170101;
		}

		.navbar-brand img {
			border: 2px solid white;
		}

		/* Dropdown item color and hover effect */
		.dropdown-menu .dropdown-item {
			color: black !important;
			/* default text color */
			transition: all 0.3s ease;
			/* smooth hover effect */
			/*background-color: #9bcbf1;*/
			color: #170101;
		}

		.dropdown-menu .dropdown-item:hover {
			background-color: #28a745 !important;
			/* green background on hover */
			color: rgb(19, 1, 1) !important;
			/* white text on hover for contrast */
		}

		/* Banner height */
		.carousel-item img {
			height: 400px;

			object-fit: cover;
			/* keeps image proportion and fills area */
		}

		/*profile */
		.flex {
			display: flex;
		}

		.fontStyle {
			text-decoration: none;
			font-style: normal;
			font-size: large;
		}

		.sidebar {
			height: 100%;
			width: 250px;
			/*position: fixed;*/
			background-color: #071b38;
		}

		.fontStyle {
			color: #f6eeee
		}

		.navlink:hover {
			background-color: #072f4e
		}

		.navlink {
			padding-bottom: 15px;
			padding-left: 20px;
		}

		#navbarNav {
			display: flex;
		}
	</style>
</head>

<body>
	<!-- NAVBAR -->
	<nav class="navbar navbar-expand-lg navbar-dark">
		<div class="container">
			<a class="navbar-brand text-center" href="#">
				<img src="./images/tiger.jpg" class="me-2 rounded-circle" alt="Logo" width="50" height="50">
				Mathapati Electricals
			</a>

			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
				aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>

			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav ms-auto">
				    <li class="nav-item mx-2 fs-5"><a class="nav-link" href="/Home"><span class="bi bi-house"></span> Home</a></li>
				    <li class="nav-item mx-2 fs-5"><a class="nav-link" href="#about"> About</a></li>
				</ul>
			</div>
		</div>
	</nav>

	<!-- profile card-->
	<section class="flex" style="margin-top: 70px;">
		<div class="container">
			<div class="sidebar" style="box-shadow: #f6eeee;">
				<nav class="nav flex-column py-4 "></nav>

				<div class="navlink">
				    <i class="bi bi-person-circle" style="font-size: 30px; color: aliceblue;"></i><br>
				    <p style="color: white;">Name: <span th:text="${sessionUser.firstName}"></span></p>
				</div>

				<div class="navlink">
					<i class="bi bi-person-circle" style="font-size: 20px; color: #fdf8f8; padding-right: 15px;"></i>
					<a href="/about-me" class="fontStyle" target="demo">About Me</a>
				</div>

				<div class="navlink">
					<i class="bi bi bi-bag-check" style="font-size: 20px; color: #fdf8f8; padding-right: 15px;"></i>
					<a href="MyOrders.html" class="fontStyle" target="demo">My Orders</a>
				</div>

				<div class="navlink">
					<i class="bi bi-heart" style="font-size: 20px; color: #fdf8f8; padding-right: 15px;"></i>
					<a href="wishlist.html" class="fontStyle" target="demo">Wish List</a>
				</div>

				<div class="navlink">
					<i class="bi bi-cart" style="font-size: 20px; color: #fdf8f8; padding-right: 15px;"></i>
					<a href="cart.html" class="fontStyle" target="demo">Cart</a>
				</div>

				<div class="navlink">
					<i class="bi bi-chat-dots" style="font-size: 20px; color: #fdf8f8; padding-right: 15px;"></i>
					<a href="feedback.html" class="fontStyle" target="demo">Feedback</a>
				</div>

				<div class="navlink">
					<i class="bi bi-box-arrow-right" style="font-size: 20px; color: #fdf8f8; padding-right: 15px;"></i>
					<a href="/user-Login" class="fontStyle">Logout</a>
				</div>

				</nav>
			</div>

		</div>
		<iframe src="" height="700px" width="6500px" name="demo"></iframe>
	</section>
	
	<main class="container-fluid my-5">

	    <footer style="background-color: #022860; color: white; padding: 40px 0;">
	      <div class="container text-center">

	        <!-- About Us inside Footer -->
	        <h5 class="fw-bold mb-3" id="aboutus">About Us</h5>
	        <p class="mb-4" style="max-width: 700px; margin: 0 auto; font-size: 16px; color: #dcdcdc;">
	          <strong>Mathapati Electricals</strong> is a platform that simplifies electrical service management,
	          inventory tracking, and analytics — helping businesses work smarter and more efficiently.
	        </p>

	        <!-- Social Media Icons -->
	        <div class="social-icons mt-3 mb-4">
	          <a href="https://www.instagram.com/mathapatielectricals/" target="_blank" class="mx-3"
	            title="Follow us on Instagram" style="color: white; text-decoration: none; font-size: 28px;">
	            <i class="bi bi-instagram"></i>
	          </a>
	          <a href="https://www.facebook.com" target="_blank" class="mx-3" title="Follow us on Facebook"
	            style="color: white; text-decoration: none; font-size: 28px;">
	            <i class="bi bi-facebook"></i>
	          </a>
	          <a href="https://www.youtube.com/@siddu-sd5449" target="_blank" class="mx-3" title="Subscribe on YouTube"
	            style="color: white; text-decoration: none; font-size: 28px;">
	            <i class="bi bi-youtube"></i>
	          </a>
	        </div>

	        <!-- Divider Line -->
	        <hr style="border-color: rgba(255,255,255,0.2); width: 60%; margin: 20px auto;">

	        <!-- Copyright -->
	        <p class="mb-0" style="font-size: 15px;">
	          &copy; 2025 <strong>E S & Inventory Analytics</strong>. All Rights Reserved.
	        </p>
	      </div>
	    </footer>


	  </main>


	<!-- profile card-->

	<!-- Bootstrap JS (CDN) -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>