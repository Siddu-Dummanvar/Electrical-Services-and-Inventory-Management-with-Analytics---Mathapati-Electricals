	<link rel="stylesheet" href="/css/products.css">


	<style>
		/* Navbar styling */
		.navbar {
			background: linear-gradient(90deg, #022860, #3f97db);
			padding-top: 4px;
			padding-bottom: 4px;
		}

		.navbar-brand {
			font-weight: bold;
			color: #fff !important;
		}

		.navbar-nav .nav-link {
			color: #fff !important;
			font-size: 1.1rem;
			transition: all 0.3s ease;
		}

		/* Main nav links hover */
		.navbar-nav .nav-link:not(.btn):hover {
			color: #000 !important;
			background-color: #fff;
			border-radius: 6px;
			transform: translateY(-2px);
		}

		.btn-outline-light:hover {
			color: #022860 !important;
		}

		/* Hero Section */
		.hero {
			background: linear-gradient(to right, #3f97db, #022860);
			color: white;
			padding: 100px 0;
			text-align: center;
		}

		.hero h1 {
			font-size: 2.5rem;
			font-weight: bold;
		}

		/* Product Card Buy Button */
		.product-card .btn-buy {
			background-color: #0d6efd;
			color: white;
			font-weight: bold;
			padding: 10px;
			border-radius: 5px;
			text-align: center;
			text-decoration: none;
			display: block;
			margin: 10px;
			transition: background-color 0.3s;
		}

		.product-card .btn-buy:hover {
			background-color: #0a58ca;
		}

		/* Professional Background for About/Footer */
		.section-bg {
			background-color: #f8f9fa;
			/* Light gray professional background */
		}

		footer {
			color: #343a40;
			/* Darker text for footer */
			padding: 2px 0;
		}

		footer small {
			color: #6c757d;
		}
	</style>
</head>

