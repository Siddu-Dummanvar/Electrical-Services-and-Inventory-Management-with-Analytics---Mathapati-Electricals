<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Cart</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <link rel="stylesheet" th:href="@{/styles.css}">
    
    <style>
        .cart-container {
            min-height: 60vh; /* Ensures footer stays at bottom if cart is empty */
        }
        .total-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            padding: 20px;
            border-radius: 5px;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(90deg, #022860, #3f97db);">
        <div class="container">
            <a class="navbar-brand" href="#">Mathapati Electricals</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link text-white" th:href="@{/Home}">Home</a></li>
                    <li class="nav-item"><a class="nav-link text-white" th:href="@{/user-profile}">Profile</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5 cart-container">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>My Shopping Cart <i class="bi bi-cart4"></i></h3>
            <a th:href="@{/Home}" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i> Continue Shopping
            </a>
        </div>
        
        <div th:if="${session.msg}" class="alert alert-success alert-dismissible fade show">
            <span th:text="${session.msg}"></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            <th:block th:text="${@sessionHelper.removeMessage()}"></th:block>
        </div>

        <div th:if="${cartItems.isEmpty()}" class="text-center py-5">
            <div class="mb-3">
                <i class="bi bi-cart-x display-1 text-muted"></i>
            </div>
            <h4>Your cart is empty</h4>
            <p class="text-muted">Looks like you haven't added anything to your cart yet.</p>
            <a th:href="@{/Home}" class="btn btn-primary mt-3">Start Shopping</a>
        </div>

        <div class="row" th:if="${!cartItems.isEmpty()}">
            <div class="col-md-9">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">Image</th>
                            <th>Product Name</th>
                            <th>Price</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr th:each="item : ${cartItems}">
                            <td class="text-center" style="width: 100px;">
                                <img th:src="@{'/images/' + ${item.product.imageName}}" 
                                     style="width: 70px; height: 70px; object-fit: cover; border-radius: 5px;">
                            </td>
                            
                            <td>
                                <h6 class="mb-0" th:text="${item.product.name}">Product Name</h6>
                                <small class="text-muted" th:text="${item.product.category.name}">Category</small>
                            </td>
                            
                            <td class="text-success fw-bold" 
                                th:text="'₹' + ${item.product.sellingPrice}">₹1200</td>
                            
                            <td>
                                <a th:href="@{'/cart/remove/' + ${item.id}}" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Remove
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="col-md-3">
                <div class="total-box shadow-sm">
                    <h4>Order Summary</h4>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Items:</span>
                        <span th:text="${cartItems.size()}">0</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-bold">Total Amount:</span>
                        <span class="fw-bold text-success fs-5" th:text="'₹' + ${totalAmount}">₹0.00</span>
                    </div>
                    <div class="d-grid gap-2">
                        <a href="#" class="btn btn-success">Checkout <i class="bi bi-credit-card"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div th:replace="~{fragments/footer-page :: fullFooter}"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>