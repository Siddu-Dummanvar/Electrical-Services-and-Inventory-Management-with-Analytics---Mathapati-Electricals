<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Service Request | Mathapati Electricals</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <style>
    body {
      background-color: #f5f8fc;
    }

    .service-container {
      max-width: 750px;
      margin: 50px auto;
      background: linear-gradient(90deg, #f1dc9c, #a3a78e);
      padding: 30px;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    h2 {
      color: #022860;
      font-weight: bold;
    }

    .form-label {
      font-weight: 500;
    }

    .btn-primary {
      background-color: #4b6ef5;
      border: none;
    }

    .btn-primary:hover {
      background-color: #3a57c4;
    }
    
    .card-img-top {
      height: 200px;
      object-fit: cover;
    }
  </style>
</head>

<body>
<div class="container text-center mt-3">
  <div class="row">
    <div class="col-md-6">
      <a class="text-decoration-none" href="/Home">Go To Home</a>
    </div>
    <div class="col-md-6 ">
      <a class="text-decoration-none" href="#serviceForm">Get Services</a>
    </div>
  </div>
</div>
 
  <div class="container mt-5">
    <h2 class="text-center mb-4 fw-bold text-primary">Our Previously Done Works</h2>
    <div class="row">
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="path/to/your/image1.jpg" class="card-img-top" alt="Event Lighting">
          <div class="card-body">
            <h5 class="card-title">Event Lighting Setup</h5>
            <p class="card-text">Professional lighting setup for a large wedding event. We handled everything from decorative to stage lighting.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="path/to/your/image2.jpg" class="card-img-top" alt="Home Wiring">
          <div class="card-body">
            <h5 class="card-title">Full Home Wiring</h5>
            <p class="card-text">Completed a full electrical wiring and switchboard installation for a new 3-bedroom home.</p>
          </div>
        </div>
      </div>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="path/to/your/image3.jpg" class="card-img-top" alt="Sound System">
          <div class="card-body">
            <h5 class="card-title">Sound System Rental</h5>
            <p class="card-text">Provided a complete sound system with setup for a local college festival, ensuring clear audio for 500+ attendees.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="container mt-5">
    <h2 class="text-center mb-4 fw-bold text-primary">Services Provided by Mathapati Electricals</h2>

    <div class="row">
      <div class="col-md-4 mb-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Light Installation</h5>
            <p class="card-text">Installation of home or office lighting systems and decorative lights.</p>
          </div>
        </div>
      </div>

      <div class="col-md-4 mb-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Fan Repair</h5>
            <p class="card-text">Repair and maintenance of ceiling, table, and wall fans.</p>
          </div>
        </div>
      </div>

      <div class="col-md-4 mb-4">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Sound System Setup</h5>
            <p class="card-text">Setup and testing of sound systems for events or functions.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="service-container">
        <h2 class="text-center mb-3">Book a Service</h2>
        <p class="text-center text-muted mb-4">Request your electrical service from Mathapati Electricals</p>

        <form id="serviceForm" onsubmit="handleSubmit(event)">

          <div class="row mb-3">
            <div class="col-md-6">
              <label for="fullName" class="form-label">Full Name</label>
              <input type="text" class="form-control" id="fullName" placeholder="Enter your full name" required>
            </div>
            <div class="col-md-6">
              <label for="serviceType" class="form-label">Type of Service</label>
              <select id="serviceType" class="form-select" required>
                <option value="">-- Select Service --</option>
                <option>Light Installation</option>
                <option>Fan Repair</option>
                <option>Sound System Setup</option>
                <option>Wiring & Switchboard</option>
                <option>Generator Setup</option>
                <option>Decoration Lights</option>
              </select>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label for="serviceDate" class="form-label">Preferred Date</label>
              <input type="date" class="form-control" id="serviceDate" required>
            </div>
            <div class="col-md-6">
              <label for="serviceTime" class="form-label">Preferred Time</label>
              <input type="time" class="form-control" id="serviceTime" required>
            </div>
          </div>

          <div class="mb-3">
            <label for="location" class="form-label">Service Location</label>
            <input type="text" class="form-control" id="location" placeholder="Enter your full address" required>
          </div>

          <div class="row mb-3">
            <div class="col-md-6">
              <label for="servicephonenumber" class="form-label">Phone Number</label>
              <input type="tel" class="form-control" id="phonenumber" pattern="[0-9]+" maxlength="10" required>
            </div>
            <div class="col-md-6">
              <label for="serviceAlternativePhoneNumber" class="form-label">Alternative Phone Number</label>
              <input type="tel" class="form-control" id="alternativephonenumber" pattern="[0-9]+" maxlength="10"
                required>
            </div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email ID (optional)</label>
            <input type="email" class="form-control" id="email" placeholder="example@gmail.com">
          </div>

          <div class="mb-3">
            <label for="details" class="form-label">Additional Details (optional)</label>
            <textarea class="form-control" id="details" rows="3"
              placeholder="Describe your problem or any special request"></textarea>
          </div>

          <div class="text-center">
            <button type="submit" class="btn btn-success px-4">Submit Request</button>
            <button type="reset" class="btn btn-secondary px-4 ms-2">Clear</button>
          </div>

        </form>
      </div>
    </div>

    <div class="alert alert-success text-center mt-4 d-none" id="successMessage">
      ✅ Your service request has been submitted successfully!
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      function handleSubmit(event) {
        event.preventDefault();
        document.getElementById('serviceForm').reset();
        document.getElementById('successMessage').classList.remove('d-none');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    </script>

</body>

</html>